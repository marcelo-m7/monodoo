<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="monodoo_home.AppCard">
        <div class="o_monodoo_app_tile position-relative h-100">
            <button
                type="button"
                class="o_monodoo_app_card btn w-100 h-100 d-flex flex-column align-items-center justify-content-center gap-2 p-3"
                t-on-click="() => this.openApp(app)"
            >
                <img
                    t-if="app.webIconData"
                    class="o_app_icon"
                    t-att-src="app.webIconData"
                    t-att-alt="app.name"
                />
                <i t-else="" class="o_monodoo_app_fallback_icon oi oi-apps fs-2" aria-hidden="true"/>
                <span class="o_monodoo_app_name text-truncate w-100" t-esc="app.name"/>
            </button>
            <button
                t-if="app.xmlid"
                type="button"
                t-attf-class="o_monodoo_favorite_toggle btn btn-sm {{ this.isFavorite(app) ? 'is-favorite' : '' }}"
                t-att-title="this.isFavorite(app) ? 'Remove from favorites' : 'Add to favorites'"
                t-att-aria-label="this.isFavorite(app) ? 'Remove from favorites' : 'Add to favorites'"
                t-on-click.stop="() => this.toggleFavorite(app)"
            >
                <i t-attf-class="fa {{ this.isFavorite(app) ? 'fa-star' : 'fa-star-o' }}" aria-hidden="true"/>
            </button>
        </div>
    </t>

    <t t-name="monodoo_home.Home">
        <div class="o_monodoo_home h-100 overflow-auto">
            <div class="o_monodoo_home_inner container py-5">
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
                    <div>
                        <h1 class="h3 mb-1">Applications</h1>
                        <p class="text-muted mb-0">Your Odoo workspace, organized around the apps you use most.</p>
                    </div>
                    <input
                        type="search"
                        class="o_monodoo_search form-control"
                        placeholder="Search applications..."
                        aria-label="Search applications"
                        t-model="state.query"
                    />
                </div>

                <section t-if="favoriteApps.length" class="o_monodoo_section o_monodoo_favorites mb-5">
                    <h2 class="o_monodoo_section_title h5 mb-3">Favorites</h2>
                    <div class="o_monodoo_app_grid row g-3">
                        <div t-foreach="favoriteApps" t-as="app" t-key="app.id" class="col-6 col-sm-4 col-md-3 col-lg-2">
                            <t t-call="monodoo_home.AppCard"/>
                        </div>
                    </div>
                </section>

                <section t-if="recentApps.length" class="o_monodoo_section o_monodoo_recent mb-5">
                    <h2 class="o_monodoo_section_title h5 mb-3">Recent</h2>
                    <div class="o_monodoo_app_grid row g-3">
                        <div t-foreach="recentApps" t-as="app" t-key="app.id" class="col-6 col-sm-4 col-md-3 col-lg-2">
                            <t t-call="monodoo_home.AppCard"/>
                        </div>
                    </div>
                </section>

                <section class="o_monodoo_section o_monodoo_all_apps">
                    <h2 class="o_monodoo_section_title h5 mb-3">All applications</h2>
                    <div t-if="apps.length" class="o_monodoo_app_grid row g-3">
                        <div t-foreach="apps" t-as="app" t-key="app.id" class="col-6 col-sm-4 col-md-3 col-lg-2">
                            <t t-call="monodoo_home.AppCard"/>
                        </div>
                    </div>
                    <div t-else="" class="o_monodoo_empty text-muted text-center py-5">
                        No applications available.
                    </div>
                </section>
            </div>
        </div>
    </t>
</templates>
