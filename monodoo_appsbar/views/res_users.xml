<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_monodoo_appsbar" model="ir.ui.view">
        <field name="name">res.users.form.monodoo.appsbar</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="monodoo_sidebar_mode" readonly="0"/>
            </xpath>
        </field>
    </record>
</odoo>
