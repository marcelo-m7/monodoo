<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_monodoo_theme" model="ir.ui.view">
        <field name="name">res.config.settings.form.monodoo.theme</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']/div[@id='companies']" position="after">
                <block title="Monodoo" name="monodoo_theme_settings">
                    <setting
                        string="Backend Theme"
                        company_dependent="1"
                        help="Choose the inheritable Monodoo identity used by this company's backend."
                    >
                        <field name="monodoo_theme_profile_id"/>
                        <div class="mt8">
                            <button
                                name="%(action_monodoo_theme_profiles)d"
                                type="action"
                                string="Manage Theme Profiles"
                                class="btn-link"
                                icon="oi-arrow-right"
                            />
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
